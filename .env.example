# Copy to .env (or export) before running.
# The public Base address buyers pay USDC to. While unset/zero, the endpoint
# advertises sales_enabled=false and /fulfill refuses every request.
SCOUTPACKS_RECEIVING_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: public base URL shown in 402 "resource" fields (else the Host header is used).
# SCOUTPACKS_PUBLIC_BASE=https://your-tunnel.trycloudflare.com
# Optional: port (default 8000)
# PORT=8000
# Optional: when set, /mcp reverse-proxies to the sibling MCP
# streamable-HTTP server (mcp/http_server.py) on this port.
# MCP_PROXY_PORT=8001
