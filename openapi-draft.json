    "/packs/{size}": {
      "get": {
        "description": "Unpaid request returns HTTP 402 with x402 v2 payment terms (PAYMENT-REQUIRED header, base64 JSON: scheme exact, network eip155:8453, payTo 0xAF7B70D8487EE6193701597E67f56A5902d23913, asset USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913). Amounts: all packs and lookups 10000 base units ($0.01 USDC). After payment, retry with the X-Payment header (standard x402 flow) or POST /fulfill with the tx hash.",
        "operationId": "getPack",
        "parameters": [
          {
            "description": "Pack size",
            "in": "path",
            "name": "size",
            "required": true,
            "schema": {
              "enum": [
                25,
                50,
                100
              ],
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "leads": {
                      "items": {
                        "$ref": "#/components/schemas/Lead"
                      },
                      "type": "array"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Paid: pack JSON (25-pack instant; 50/100 return an order receipt after /fulfill)"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "currency": {
                      "example": "USDC",
                      "type": "string"
                    },
                    "error": {
                      "example": "payment_required",
                      "type": "string"
                    },
                    "fulfillment": {
                      "type": "string"
                    },
                    "how_to_pay": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "leads": {
                      "example": 25,
                      "type": "integer"
                    },
                    "network": {
                      "example": "eip155:8453",
                      "type": "string"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    },
                    "price_usd": {
                      "example": 9,
                      "type": "number"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Payment required \u2014 x402 terms in PAYMENT-REQUIRED header"
          }
        },
        "summary": "Buy a lead pack (x402 paywall)"
      }
    },
    "/lookup": {
      "get": {
        "operationId": "lookupLead",
        "description": "Look up one verified B2B contact by company name or source domain. Unpaid request returns HTTP 402 with x402 v2 payment terms (PAYMENT-REQUIRED header, base64 JSON: scheme exact, network eip155:8453, maxAmountRequired 10000 base units = $0.01 USDC, payTo 0xAF7B70D8487EE6193701597E67f56A5902d23913, asset USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913). Pay $0.01 USDC on Base via signed x402: retry with the signature in X-PAYMENT (v1) or PAYMENT-SIGNATURE (v2) to receive the verified contact (manual fallback: POST /fulfill-lookup with {\"tx_hash\": \"0x...\", \"query\": \"<same query>\"}). No match returns 404 with suggestions.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Company name (e.g. 'Acme Corp') or source domain (e.g. 'acme.com').",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "402": {
            "description": "Payment required \u2014 x402 v2 terms in body and PAYMENT-REQUIRED header."
          },
          "404": {
            "description": "No verified contact found for this query."
          }
        }
      }
    },
    "/fulfill-lookup": {
      "post": {
        "operationId": "fulfillLookup",
        "description": "Redeem a $0.01 USDC lookup payment. The endpoint verifies the USDC transfer on-chain (exact payTo, sufficient amount, tx not previously redeemed) and returns the verified contact: company, location, category, verified business email, source URL, provenance.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tx_hash",
                  "query"
                ],
                "properties": {
                  "tx_hash": {
                    "type": "string",
                    "description": "0x... transaction hash of the USDC payment on Base."
                  },
                  "query": {
                    "type": "string",
                    "description": "The same query string used in GET /lookup."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified contact JSON."
          },
          "402": {
            "description": "Payment not verified on-chain."
          },
          "409": {
            "description": "Transaction hash already redeemed."
          }
        }
      }
    },
    "/deliverability": {
      "get": {
        "summary": "Email deliverability score \u2014 $0.03 USDC per call (x402, Base)",
        "description": "MX/SPF/DMARC checks, disposable-domain and role-account detection. Returns score 0-100 with send/caution/do_not_send verdict. Paid via x402 signed settlement or POST /fulfill-deliverability.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Email address to score. Use email OR domain."
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Domain to score. Use email OR domain."
          }
        ],
        "responses": {
          "200": {
            "description": "Deliverability score (paid)"
          },
          "402": {
            "description": "Payment required (x402)"
          },
          "400": {
            "description": "Missing target"
          }
        }
      }
    },
    "/fulfill-deliverability": {
      "post": {
        "summary": "Manual fulfillment for deliverability scores",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tx_hash": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                },
                "required": [
                  "tx_hash",
                  "target"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score delivered"
          },
          "402": {
            "description": "Payment not verified"
          }
        }
      }
    },
    "/dns": {
      "get": {
        "summary": "DNS record dump \u2014 $0.01 USDC per call (x402, Base)",
        "description": "A, AAAA, MX, TXT, NS and CNAME records via Cloudflare DNS-over-HTTPS, plus SPF presence signal. One domain per call. Paid via x402 signed settlement or POST /fulfill-dns. Zero upstream cost (free public DoH, no key).",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
