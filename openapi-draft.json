{
  "components": {
    "schemas": {
      "Lead": {
        "description": "One verified B2B lead. Every field present; if a business email is not published, the lead is not in the pack.",
        "properties": {
          "category": {
            "type": "string"
          },
          "city_state": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "contact_email": {
            "description": "Published business email (never pattern-matched or guessed)",
            "format": "email",
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "source_url": {
            "description": "URL where the contact info was published",
            "format": "uri",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "company_name",
          "contact_name",
          "contact_email",
          "source_url"
        ],
        "type": "object"
      },
      "LeadPreview": {
        "description": "Redacted sample lead \u2014 email masked",
        "properties": {
          "company_name": {
            "type": "string"
          },
          "contact_email": {
            "example": "j***@example.com",
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Tiger Operations",
      "url": "https://github.com/tigerops-win/scout-packs"
    },
    "description": "$0.01/lead B2B contact lookup for AI agents over x402 (USDC on Base, eip155:8453). GET /lookup?query=<company or domain> returns HTTP 402 with payment terms; pay $0.01 USDC, POST /fulfill-lookup with the tx hash to receive one verified business email + source URL + provenance. No account, no API key, no subscription. Verified B2B lead packs sold to AI agents over x402 (USDC on Base, eip155:8453). Packs: 25 leads $0.01 (instant JSON), 50 leads $0.01, 100 leads $0.01 (assembled within 24h). Every lead: company, contact, title, published business email, source URL. No account, no API key, no subscription. Unpaid requests to paid routes return HTTP 402 with x402 v2 payment terms in the PAYMENT-REQUIRED header.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/tigerops-win/scout-packs/blob/main/LICENSE"
    },
    "title": "Scout Packs \u2014 Tiger Operations",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/x402": {
      "get": {
        "operationId": "x402Manifest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "resources": {
                      "items": {
                        "properties": {
                          "accepts": {
                            "items": {
                              "properties": {
                                "asset": {
                                  "example": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                                  "type": "string"
                                },
                                "description": {
                                  "type": "string"
                                },
                                "maxAmountRequired": {
                                  "example": "10000",
                                  "type": "string"
                                },
                                "maxTimeoutSeconds": {
                                  "example": 300,
                                  "type": "integer"
                                },
                                "mimeType": {
                                  "example": "application/json",
                                  "type": "string"
                                },
                                "network": {
                                  "example": "eip155:8453",
                                  "type": "string"
                                },
                                "payTo": {
                                  "example": "0xAF7B70D8487EE6193701597E67f56A5902d23913",
                                  "type": "string"
                                },
                                "scheme": {
                                  "example": "exact",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "resource": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sales_enabled": {
                      "type": "boolean"
                    },
                    "x402Version": {
                      "example": 2,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Machine-readable payment terms for all packs"
          }
        },
        "summary": "x402 v2 payment manifest (free)"
      }
    },
    "/catalog": {
      "get": {
        "operationId": "catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "packs": {
                      "additionalProperties": {
                        "properties": {
                          "currency": {
                            "example": "USDC",
                            "type": "string"
                          },
                          "fulfillment_eta": {
                            "example": "instant",
                            "type": "string"
                          },
                          "leads": {
                            "example": 25,
                            "type": "integer"
                          },
                          "network": {
                            "example": "eip155:8453",
                            "type": "string"
                          },
                          "price_usd": {
                            "example": 9,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "type": "object"
                    },
                    "sales_enabled": {
                      "type": "boolean"
                    },
                    "seller": {
                      "example": "Tiger Operations",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Available packs"
          }
        },
        "summary": "Pack catalog and prices (free)"
      }
    },
    "/fulfill": {
      "post": {
        "description": "POST the on-chain tx hash after paying. Returns the 25-pack JSON immediately; returns an order receipt for 50/100 (assembled and delivered within 24h of payment confirmation).",
        "operationId": "fulfill",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "pack": {
                    "enum": [
                      "25",
                      "50",
                      "100"
                    ],
                    "type": "string"
                  },
                  "tx_hash": {
                    "description": "Base transaction hash of the USDC payment",
                    "example": "0xabc123...",
                    "type": "string"
                  }
                },
                "required": [
                  "tx_hash",
                  "pack"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Pack JSON (25) or order receipt (50/100)"
          },
          "400": {
            "description": "Invalid tx hash or pack"
          },
          "402": {
            "description": "Payment not found / insufficient on-chain"
          }
        },
        "summary": "Submit payment proof, receive pack"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "example": true,
                      "type": "boolean"
                    },
                    "sales_enabled": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Service status"
          }
        },
        "summary": "Health check"
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "llmsTxt",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Plain-text buying guide for agents"
          }
        },
        "summary": "Agent-readable product notes (free)"
      }
    },
    "/packs/25/preview": {
      "get": {
        "operationId": "preview25",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "leads": {
                      "items": {
                        "$ref": "#/components/schemas/LeadPreview"
                      },
                      "type": "array"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    },
                    "preview": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Sample leads with emails masked"
          }
        },
        "summary": "Redacted 25-pack sample (free)"
      }
    },
    "/packs/{size}": {
      "get": {
        "description": "Unpaid request returns HTTP 402 with x402 v2 payment terms (PAYMENT-REQUIRED header, base64 JSON: scheme exact, network eip155:8453, payTo 0xAF7B70D8487EE6193701597E67f56A5902d23913, asset USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913). Amounts: all packs and lookups 10000 base units ($0.01 USDC). After payment, retry with the X-Payment header (standard x402 flow) or POST /fulfill with the tx hash.",
        "operationId": "getPack",
        "parameters": [
          {
            "description": "Pack size",
            "in": "path",
            "name": "size",
            "required": true,
            "schema": {
              "enum": [
                25,
                50,
                100
              ],
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "leads": {
                      "items": {
                        "$ref": "#/components/schemas/Lead"
                      },
                      "type": "array"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Paid: pack JSON (25-pack instant; 50/100 return an order receipt after /fulfill)"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "currency": {
                      "example": "USDC",
                      "type": "string"
                    },
                    "error": {
                      "example": "payment_required",
                      "type": "string"
                    },
                    "fulfillment": {
                      "type": "string"
                    },
                    "how_to_pay": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "leads": {
                      "example": 25,
                      "type": "integer"
                    },
                    "network": {
                      "example": "eip155:8453",
                      "type": "string"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    },
                    "price_usd": {
                      "example": 9,
                      "type": "number"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Payment required \u2014 x402 terms in PAYMENT-REQUIRED header"
          }
        },
        "summary": "Buy a lead pack (x402 paywall)"
      }
    },
    "/lookup": {
      "get": {
        "operationId": "lookupLead",
        "description": "Look up one verified B2B contact by company name or source domain. Unpaid request returns HTTP 402 with x402 v2 payment terms (PAYMENT-REQUIRED header, base64 JSON: scheme exact, network eip155:8453, maxAmountRequired 10000 base units = $0.01 USDC, payTo 0xAF7B70D8487EE6193701597E67f56A5902d23913, asset USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913). After paying $0.01 USDC on Base, POST /fulfill-lookup with {\"tx_hash\": \"0x...\", \"query\": \"<same query>\"} to receive the verified contact. No match returns 404 with suggestions.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Company name (e.g. 'Acme Corp') or source domain (e.g. 'acme.com').",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "402": {
            "description": "Payment required \u2014 x402 v2 terms in body and PAYMENT-REQUIRED header."
          },
          "404": {
            "description": "No verified contact found for this query."
          }
        }
      }
    },
    "/fulfill-lookup": {
      "post": {
        "operationId": "fulfillLookup",
        "description": "Redeem a $0.01 USDC lookup payment. The endpoint verifies the USDC transfer on-chain (exact payTo, sufficient amount, tx not previously redeemed) and returns the verified contact: company, location, category, verified business email, source URL, provenance.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tx_hash",
                  "query"
                ],
                "properties": {
                  "tx_hash": {
                    "type": "string",
                    "description": "0x... transaction hash of the USDC payment on Base."
                  },
                  "query": {
                    "type": "string",
                    "description": "The same query string used in GET /lookup."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified contact JSON."
          },
          "402": {
            "description": "Payment not verified on-chain."
          },
          "409": {
            "description": "Transaction hash already redeemed."
          }
        }
      }
    }
  },
  "servers": [
    {
      "description": "Live endpoint (Railway production)",
      "url": "https://scout-packs-production.up.railway.app"
    }
  ],
  "tags": [
    {
      "description": "Paid lead-pack routes (x402)",
      "name": "packs"
    },
    {
      "description": "Free machine-readable routes",
      "name": "discovery"
    }
  ]
}