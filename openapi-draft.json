{
  "components": {
    "schemas": {
      "Lead": {
        "description": "One verified B2B lead. Every field present; if a business email is not published, the lead is not in the pack.",
        "properties": {
          "category": {
            "type": "string"
          },
          "city_state": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "contact_email": {
            "description": "Published business email (never pattern-matched or guessed)",
            "format": "email",
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "source_url": {
            "description": "URL where the contact info was published",
            "format": "uri",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "company_name",
          "contact_name",
          "contact_email",
          "source_url"
        ],
        "type": "object"
      },
      "LeadPreview": {
        "description": "Redacted sample lead \u2014 email masked",
        "properties": {
          "company_name": {
            "type": "string"
          },
          "contact_email": {
            "example": "j***@example.com",
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Tiger Operations",
      "url": "https://github.com/tigerops-win/scout-packs"
    },
    "description": "$0.01/lead B2B contact lookup for AI agents over x402 (USDC on Base, eip155:8453). GET /lookup?query=<company or domain> returns HTTP 402 with payment terms; pay $0.01 USDC via signed x402 (retry with X-PAYMENT / PAYMENT-SIGNATURE) to receive one verified business email + source URL + provenance (manual fallback: POST /fulfill-lookup with the tx hash). No account, no API key, no subscription. Verified B2B lead packs sold to AI agents over x402 (USDC on Base, eip155:8453). Packs: 25 leads $0.01 (instant JSON), 50 leads $0.01, 100 leads $0.01 (assembled within 24h). Every lead: company, contact, title, published business email, source URL. No account, no API key, no subscription. Unpaid requests to paid routes return HTTP 402 with x402 v2 payment terms in the PAYMENT-REQUIRED header.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/tigerops-win/scout-packs/blob/main/LICENSE"
    },
    "title": "Scout Packs \u2014 Tiger Operations",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/x402": {
      "get": {
        "operationId": "x402Manifest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "resources": {
                      "items": {
                        "properties": {
                          "accepts": {
                            "items": {
                              "properties": {
                                "asset": {
                                  "example": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                                  "type": "string"
                                },
                                "description": {
                                  "type": "string"
                                },
                                "maxAmountRequired": {
                                  "example": "10000",
                                  "type": "string"
                                },
                                "maxTimeoutSeconds": {
                                  "example": 300,
                                  "type": "integer"
                                },
                                "mimeType": {
                                  "example": "application/json",
                                  "type": "string"
                                },
                                "network": {
                                  "example": "eip155:8453",
                                  "type": "string"
                                },
                                "payTo": {
                                  "example": "0xAF7B70D8487EE6193701597E67f56A5902d23913",
                                  "type": "string"
                                },
                                "scheme": {
                                  "example": "exact",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "resource": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sales_enabled": {
                      "type": "boolean"
                    },
                    "x402Version": {
                      "example": 2,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Machine-readable payment terms for all packs"
          }
        },
        "summary": "x402 v2 payment manifest (free)"
      }
    },
    "/catalog": {
      "get": {
        "operationId": "catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "packs": {
                      "additionalProperties": {
                        "properties": {
                          "currency": {
                            "example": "USDC",
                            "type": "string"
                          },
                          "fulfillment_eta": {
                            "example": "instant",
                            "type": "string"
                          },
                          "leads": {
                            "example": 25,
                            "type": "integer"
                          },
                          "network": {
                            "example": "eip155:8453",
                            "type": "string"
                          },
                          "price_usd": {
                            "example": 9,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "type": "object"
                    },
                    "sales_enabled": {
                      "type": "boolean"
                    },
                    "seller": {
                      "example": "Tiger Operations",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Available packs"
          }
        },
        "summary": "Pack catalog and prices (free)"
      }
    },
    "/fulfill": {
      "post": {
        "description": "POST the on-chain tx hash after paying. Returns the 25-pack JSON immediately; returns an order receipt for 50/100 (assembled and delivered within 24h of payment confirmation).",
        "operationId": "fulfill",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "pack": {
                    "enum": [
                      "25",
                      "50",
                      "100"
                    ],
                    "type": "string"
                  },
                  "tx_hash": {
                    "description": "Base transaction hash of the USDC payment",
                    "example": "0xabc123...",
                    "type": "string"
                  }
                },
                "required": [
                  "tx_hash",
                  "pack"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Pack JSON (25) or order receipt (50/100)"
          },
          "400": {
            "description": "Invalid tx hash or pack"
          },
          "402": {
            "description": "Payment not found / insufficient on-chain"
          }
        },
        "summary": "Submit payment proof, receive pack"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "example": true,
                      "type": "boolean"
                    },
                    "sales_enabled": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Service status"
          }
        },
        "summary": "Health check"
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "llmsTxt",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Plain-text buying guide for agents"
          }
        },
        "summary": "Agent-readable product notes (free)"
      }
    },
    "/packs/25/preview": {
      "get": {
        "operationId": "preview25",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "leads": {
                      "items": {
                        "$ref": "#/components/schemas/LeadPreview"
                      },
                      "type": "array"
                    },
                    "pack": {
                      "example": "scout-pack-25",
                      "type": "string"
                    },
                    "preview": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Sample leads with emails masked"
          }
        },
        "summary": "Redacted 25-pack sample (free)"
      }
